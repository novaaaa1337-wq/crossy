# Copy to .env and edit.

# Every 0.05 SOL entry and every skin purchase is sent here.
RECEIVER_WALLET=6s88p25hjVgESfoa9mSwqwmyDV2AT2hrVWgGZ6SLiTt7

# Password for /admin.html, where you see each round's winner and mark the prize as paid.
# Use a long random string.
ADMIN_TOKEN=
# Postgres connection string. On Vercel, adding a Neon database sets this for you.
# Leave empty locally to use a built-in database in ./.pglite
DATABASE_URL=
PORT=3000

ENTRY_SOL=0.05
BASE_POOL_SOL=2
ROUND_MINUTES=15

SKIN_FROG_SOL=0.1
SKIN_PENGUIN_SOL=0.15
SKIN_FOX_SOL=0.25
SKIN_ROBOT_SOL=0.5
