# Copy to .env and edit.
CLUSTER=mainnet-beta
# The public endpoint is rate-limited. Use a paid RPC (Helius, Triton, QuickNode) in production.
RPC_URL=https://api.mainnet-beta.solana.com

# Every 0.05 SOL entry and every skin purchase is sent here.
RECEIVER_WALLET=6s88p25hjVgESfoa9mSwqwmyDV2AT2hrVWgGZ6SLiTt7

# The wallet that pays the prizes. Fund it with enough SOL for upcoming pools.
# On a host, set TREASURY_SECRET (the base58 private key) in the dashboard. Locally you can use a file instead.
# Never commit either.
TREASURY_SECRET=
TREASURY_KEYPAIR=./treasury.json
DB_PATH=./crossy-mainnet.db
PORT=3000

ENTRY_SOL=0.05
BASE_POOL_SOL=2
ROUND_MINUTES=15

SKIN_FROG_SOL=0.1
SKIN_PENGUIN_SOL=0.15
SKIN_FOX_SOL=0.25
SKIN_ROBOT_SOL=0.5
