# Copy to .env and edit.
CLUSTER=mainnet-beta
# The public endpoint is rate-limited. Use a paid RPC (Helius, Triton, QuickNode) in production.
RPC_URL=https://api.mainnet-beta.solana.com

# Every 0.05 SOL entry and every skin purchase is sent here.
RECEIVER_WALLET=6s88p25hjVgESfoa9mSwqwmyDV2AT2hrVWgGZ6SLiTt7

# Password for /admin.html, where you see each round's winner and mark the prize as paid.
# Use a long random string.
ADMIN_TOKEN=
DB_PATH=./crossy-mainnet.db
PORT=3000

ENTRY_SOL=0.05
BASE_POOL_SOL=2
ROUND_MINUTES=15

SKIN_FROG_SOL=0.1
SKIN_PENGUIN_SOL=0.15
SKIN_FOX_SOL=0.25
SKIN_ROBOT_SOL=0.5
